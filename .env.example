# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=localhostairlines
POSTGRES_PASSWORD=
POSTGRES_DB=localhostairlines
DATABASE_URL=postgresql+asyncpg://localhostairlines:@postgres:5432/localhostairlines

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Application ------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=
LOG_LEVEL=INFO
BASE_CURRENCY=EUR

# --- Sources ----------------------------------------------------------------
# Free, self-service token from travelpayouts.com. See docs/providers.md.
TRAVELPAYOUTS_TOKEN=

# Sources not yet adopted are disabled by default and enabled per docs/providers.md
# only after their spike is positive and their health has been observed.
ENABLE_GOOGLE_FLIGHTS=false
ENABLE_AIRLINE_ENDPOINTS=false
ENABLE_AWARD_SCRAPER=false

# --- Telegram (optional; the web application is unaffected if unset) --------
TELEGRAM_BOT_TOKEN=

# --- Backup -----------------------------------------------------------------
# Destination for the nightly dump. Must be outside this machine (spec §81).
BACKUP_TARGET=
