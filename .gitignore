.DS_Store

# Secrets. .env.example is committed; .env never is.
.env
.env.*
!.env.example
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo
# Generated by @tanstack/router-plugin as a build/dev side effect (apps/web).
# No leading slash and a path this specific: an unanchored single-segment
# pattern would also catch a hypothetical unrelated src/ elsewhere, and a
# root-anchored one (a bare "src/routeTree.gen.ts") only matches at the repo
# root, not apps/web/src/ — silently missing the actual generated file and
# staging it by accident, which is how this got noticed (issue #44).
**/src/routeTree.gen.ts

# Local data. Volumes live in Docker, but keep stray dumps out of the tree.
*.dump
*.sql.gz
data/
